opam-version: "2.0"
name: "rocq-semantics-course"
license: "BSD-3-Clause"
maintainer: "Lennard Gäher"
authors: "Derek Dreyer, Simon Spies, Lennard Gäher, Benjamin Peters, Niklas Mück"
synopsis: "Best course this side of the milky way"
homepage: "https://plv.mpi-sws.org/semantics-course/"
bug-reports: "https://gitlab.mpi-sws.org/FP/semantics-course/issues"
version: "dev"

depends: [
  "coq" { (>= "9.0" & < "9.1~") | (= "dev") }
  "coq-iris-heap-lang" { (= "dev.2025-07-17.3.adf6beba") | (= "dev") }
  "coq-equations" { (= "1.3.1+9.0") }
  "coq-autosubst" { (= "1.9") | (= "dev") }
]

build: [make "-j%{jobs}%"]
install: [make "install"]
